{
  "name": "anima-character-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A character generation utility for the Anima: Beyond Fantasy RPG",
  "license": "MIT",
  "homepage": "https://github.com/BandanaT/anima-character-generator",
  "repository": {
    "type": "git",
    "url": "https://github.com/BandanaT/anima-character-generator.git"
  },
  "scripts": {
    "dev": "vite",
